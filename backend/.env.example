# For running the backend outside Docker (npm run dev)
PORT=5000
DB_HOST=localhost
DB_PORT=3307
DB_NAME=aismp
DB_USER=aismp
DB_PASSWORD=aismp_pass
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
ML_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173

# Password reset emails (optional). Without SMTP_HOST the reset link is printed in the backend log
# and shown on screen in development, so the feature still works for demos.
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AISMP <no-reply@aismp.local>"
